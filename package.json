{
  "name": "muro",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.ts"
  ],
  "scripts": {
    "build:js": "bun build ./index.ts --outdir ./dist --target node --format esm --external zod",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "typescript": "^5.0.0",
    "zod": "^3.24.2 || ^4.0.0"
  }
}